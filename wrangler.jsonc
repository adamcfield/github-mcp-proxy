{
  "name": "github-mcp-worker",
  "account_id": "c12e34b24c2857ab93bda8c4b529db5f",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitHubMCP"]
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "GitHubMCP"
      }
    ]
  },

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "7fc518d9560848cc96c06ba5d8d1ef57"
    }
  ],

  "observability": {
    "enabled": true
  }
}
